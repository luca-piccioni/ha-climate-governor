{
  "config": {
    "step": {
      "user": {
        "title": "Climate Governor",
        "description": "Configure the system-wide settings for this heating/cooling plant. Zones and schedules are added as sub-entries.",
        "data": {
          "name": "Name",
          "outdoor_entity_id": "Outdoor temperature source (sensor or weather entity)",
          "outdoor_design_temp": "Design outdoor temperature (coldest expected, used for outdoor reset)"
        }
      },
      "zone": {
        "title": "Add the first zone",
        "description": "Add the first thermal zone. You can add more zones and time periods later from the integration page.",
        "data": {
          "zone_name": "Zone name",
          "area_id": "Area",
          "floor_id": "Floor",
          "temperature_sensors": "Temperature sensors (one or more)",
          "humidity_sensor": "Humidity sensor (optional, phase 2)",
          "heat_switch": "Motorized valve (switch)",
          "heat_climate": "Heating climate actuator",
          "cool_climate": "Cooling climate actuator",
          "aggregation": "Sensor aggregation"
        },
        "data_description": {
          "heat_switch": "A switch entity driving a motorized valve; controlled by duty-cycle.",
          "heat_climate": "A climate entity used as a heating cascade (setpoint shift).",
          "cool_climate": "A climate entity used as a cooling cascade (setpoint shift)."
        },
        "sections": {
          "advanced": {
            "name": "Advanced control tuning",
            "description": "Per-zone overrides of the control law. Leave empty to use the global defaults.",
            "data": {
              "tolerance": "Deadband tolerance",
              "kp": "Proportional gain (Kp)",
              "ki": "Integral gain (Ki)",
              "max_offset": "Max cascade setpoint offset",
              "cycle_window": "Duty-cycle window"
            }
          }
        }
      },
      "reconfigure": {
        "title": "Reconfigure Climate Governor",
        "description": "Edit the system-wide settings.",
        "data": {
          "name": "[%key:component::climate_governor::config::step::user::data::name%]",
          "outdoor_entity_id": "[%key:component::climate_governor::config::step::user::data::outdoor_entity_id%]",
          "outdoor_design_temp": "[%key:component::climate_governor::config::step::user::data::outdoor_design_temp%]"
        }
      }
    },
    "error": {
      "no_sensors": "Select at least one temperature sensor.",
      "no_actuator": "Select at least one actuator (a valve switch or a climate entity)."
    },
